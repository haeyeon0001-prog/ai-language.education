source "https://rubygems.org"

# Jekyll 4.x（Netlify ビルド環境向け）
gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-seo-tag", "~> 2.8"
end

# csv は Ruby 3.4+ で標準ライブラリから外れたので明示
gem "csv", "~> 3.3"

# logger は Ruby 3.5+ で標準ライブラリから外れる可能性があるため明示
gem "logger", "~> 1.6"

# base64 同様
gem "base64", "~> 0.2"
